# Basic Django config
SECRET_KEY=please-change-me
DEBUG=True
ALLOWED_HOSTS=*

# Database selection: sqlite or mysql
DB_ENGINE=sqlite

# SQLite (default) - DB_NAME is the sqlite file path
DB_NAME=db.sqlite3

# MySQL settings (used only when DB_ENGINE=mysql)
# DB_NAME=caddy_db
# DB_USER=root
# DB_PASSWORD=changeme
# DB_HOST=127.0.0.1
# DB_PORT=3306
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Regional settings
TIME_ZONE=Europe/Dublin
